---
import { path } from "../data/directions";
import { identity } from "../data/cv";
import type { Locale } from "../data/cv";
interface Props {
  locale: Locale;
  title: string;
  theme?: string;
  preview?: boolean;
}
const { locale, title, theme = "gallery", preview = true } = Astro.props;
const canonical = new URL(path(`${locale}/`), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content={preview ? "noindex, nofollow" : "index, follow"}
    />
    <meta
      name="description"
      content={preview
        ? locale === "es"
          ? "Archivo de propuestas para el CV RPG de Matteo Fecci."
          : "Design archive for Matteo Fecci's RPG CV."
        : `${identity.name}, ${identity.role}. ${identity.introduction[locale]}`}
    />
    {
      !preview && (
        <>
          <link rel="canonical" href={canonical.href} />
          <link
            rel="alternate"
            hreflang="es"
            href={new URL(path("es/"), Astro.site).href}
          />
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(path("en/"), Astro.site).href}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(path(), Astro.site).href}
          />
        </>
      )
    }
    <title>{title} | Matteo Fecci</title>
    <link rel="icon" href={path("favicon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      href={path("fonts/manrope-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={path("styles/core.css")} />
    {
      theme !== "gallery" && (
        <link rel="stylesheet" href={path(`styles/${theme}.css`)} />
      )
    }
    <link rel="stylesheet" href={path("styles/motion.css")} />
  </head>
  <body class={theme}>
    <a class="skip-link" href="#main"
      >{locale === "es" ? "Ir al contenido" : "Skip to content"}</a
    >
    <slot />
  </body>
</html>
