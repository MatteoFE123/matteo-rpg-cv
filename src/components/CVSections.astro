---
import {
  certifications,
  copy,
  education,
  experience,
  identity,
  period,
  projects,
  skillGroups,
} from "../data/cv";
import type { Locale } from "../data/cv";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copy[locale];
---

<section class="profile-section reading-section" aria-labelledby="about-title">
  <h2 id="about-title">{c.profile}</h2>
  <p>{identity.summary[locale]}</p>
</section>
<section
  id="skills"
  class="skills-section reading-section"
  aria-labelledby="skills-title"
>
  <h2 id="skills-title">{c.grimoire} <span>{c.skills}</span></h2>
  <div class="skill-filters" role="group" aria-label={c.skillFilter}>
    <button type="button" data-filter="all" aria-pressed="true">{c.all}</button>
    {
      skillGroups.map((group) => (
        <button type="button" data-filter={group.id} aria-pressed="false">
          {group.name[locale]}
        </button>
      ))
    }
  </div>
  <div class="skill-groups">
    {
      skillGroups.map((group) => (
        <section class="skill-group" data-skill-group={group.id}>
          <h3>{group.name[locale]}</h3>
          <ul>
            {group.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="filter-result" aria-live="polite">
    <span data-skill-count
      >{
        skillGroups.reduce((count, group) => count + group.skills.length, 0)
      }</span
    >
    {c.skillsShown}
  </p>
  <p class="source-note">{c.narrative}</p>
</section>
<section
  id="career"
  class="career-section reading-section"
  aria-labelledby="career-title"
>
  <h2 id="career-title">{c.chronicle} <span>{c.trajectory}</span></h2>
  <ol class="career-list">
    {
      experience.map((job) => (
        <li>
          <div class="career-meta">
            <h3>{job.employer}</h3>
            <p>{period(job.start, job.end, locale)}</p>
          </div>
          <div class="career-work">
            <p class="job-role">{job.role}</p>
            <p>{job.description[locale]}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
<section
  id="projects"
  class="projects-section reading-section"
  aria-labelledby="projects-title"
>
  <h2 id="projects-title">{c.quests} <span>{c.projects}</span></h2>
  <p class="source-note">{c.evidence}</p>
  <div class="project-list">
    {
      projects.map((project) => (
        <details>
          <summary>
            {project.name[locale]} <span>{project.employer}</span>
          </summary>
          <div class="project-body">
            <p>{project.description[locale]}</p>
            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
</section>
<section
  id="education"
  class="education-section reading-section"
  aria-labelledby="education-title"
>
  <h2 id="education-title">{c.training} <span>{c.education}</span></h2>
  <ul class="education-list">
    {
      education.map((item) => (
        <li>
          <h3>{item.name[locale]}</h3>
          <p>{item.institution}</p>
          {item.detail && <p>{item.detail[locale]}</p>}
        </li>
      ))
    }
  </ul>
  <h3 class="certification-title">{c.certifications}</h3>
  <ul class="certifications">
    {certifications.map((item) => <li>{item}</li>)}
  </ul>
</section>
<footer class="cv-footer">
  <p>{identity.name}<br />{identity.role}</p>
  <a
    class="button"
    href={identity.linkedin}
    target="_blank"
    rel="noopener noreferrer">{c.contact}</a
  >
  <p class="source-note">{c.source}</p>
</footer>
<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const running = new Set<Animation>();
  const settleDisclosures: (() => void)[] = [];
  function animate(element: HTMLElement, frames: Keyframe[], duration = 280) {
    if (reducedMotion.matches || document.hidden || !element.animate)
      return null;
    const animation = element.animate(frames, {
      duration,
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
    });
    running.add(animation);
    const cleanup = () => running.delete(animation);
    animation.finished.then(cleanup, cleanup);
    return animation;
  }
  function layoutTargets(container: HTMLElement, following = false) {
    const targets = Array.from(container.children).filter(
      (element): element is HTMLElement => element instanceof HTMLElement,
    );
    let next = following
      ? container.closest(".reading-section")?.nextElementSibling
      : null;
    while (next) {
      if (next instanceof HTMLElement) targets.push(next);
      next = next.nextElementSibling;
    }
    return targets;
  }
  function changeLayout(
    targets: HTMLElement[],
    update: () => void,
    duration = 280,
  ) {
    const previous = new Map(
      targets
        .filter((element) => !element.hidden)
        .map((element) => [element, element.getBoundingClientRect()]),
    );
    for (const element of targets) {
      for (const animation of element.getAnimations?.() ?? []) {
        if (running.has(animation)) animation.cancel();
      }
    }
    update();
    if (reducedMotion.matches || document.hidden) return;
    for (const element of targets) {
      if (element.hidden) continue;
      const before = previous.get(element);
      const after = element.getBoundingClientRect();
      const x = before ? before.left - after.left : 0;
      const y = before ? before.top - after.top : 6;
      if (before && !x && !y) continue;
      animate(
        element,
        [{ transform: `translate(${x}px, ${y}px)` }, { transform: "none" }],
        duration,
      );
    }
  }
  function settleMotion() {
    for (const animation of running) animation.cancel();
    for (const settle of settleDisclosures) settle();
  }
  reducedMotion.addEventListener("change", () => {
    if (reducedMotion.matches) settleMotion();
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) settleMotion();
  });
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const groups = document.querySelectorAll<HTMLElement>("[data-skill-group]");
  const count = document.querySelector("[data-skill-count]");
  const skillContainer = document.querySelector<HTMLElement>(".skill-groups")!;
  for (const button of filters) {
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-pressed") === "true") return;
      const selected = button.dataset.filter;
      changeLayout(layoutTargets(skillContainer), () => {
        for (const filter of filters) {
          filter.setAttribute("aria-pressed", String(filter === button));
        }
        let visible = 0;
        for (const group of groups) {
          group.hidden =
            selected !== "all" && group.dataset.skillGroup !== selected;
          if (!group.hidden) visible += group.querySelectorAll("li").length;
        }
        if (count) count.textContent = String(visible);
      });
    });
  }
  for (const details of document.querySelectorAll<HTMLDetailsElement>(
    ".project-list details",
  )) {
    const summary = details.querySelector("summary")!;
    const body = details.querySelector<HTMLElement>(".project-body")!;
    let targetOpen = details.open;
    let contentAnimation: Animation | null = null;
    const setOpen = (duration = 280) =>
      changeLayout(
        layoutTargets(details.parentElement!, true),
        () => {
          details.open = targetOpen;
        },
        duration,
      );
    settleDisclosures.push(() => {
      contentAnimation = null;
      details.open = targetOpen;
    });
    details.addEventListener("toggle", () => {
      if (!contentAnimation) targetOpen = details.open;
    });
    summary.addEventListener("click", (event) => {
      event.preventDefault();
      targetOpen = !targetOpen;
      const opacity = getComputedStyle(body).opacity;
      const clipPath = details.open
        ? getComputedStyle(body).clipPath
        : "inset(0 0 100% 0)";
      contentAnimation?.cancel();
      contentAnimation = null;
      if (targetOpen) {
        setOpen();
        contentAnimation = animate(body, [
          { clipPath, opacity },
          { clipPath: "inset(0)", opacity: 1 },
        ]);
      } else {
        contentAnimation = animate(
          body,
          [
            { opacity, clipPath, transform: "none" },
            { opacity: 0, clipPath, transform: "translateY(-3px)" },
          ],
          150,
        );
        if (!contentAnimation) setOpen();
      }
      const current = contentAnimation;
      current?.finished.then(
        () => {
          if (contentAnimation !== current) return;
          contentAnimation = null;
          if (!targetOpen) setOpen(110);
        },
        () => {},
      );
    });
  }
</script>
