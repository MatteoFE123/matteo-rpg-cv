---
import { copy, identity } from "../data/cv";
import type { Locale } from "../data/cv";
import { path } from "../data/directions";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="option-identity">
  <h1 id="profile-title">{identity.name}</h1>
  <p class="professional-role">{identity.role}</p>
  <p class="introduction">{identity.introduction[locale]}</p>
  <a
    class="button primary-action"
    href={path(`cv/matteo-fecci-${locale}.pdf`)}
    download>{copy[locale].download}</a
  >
</div>
