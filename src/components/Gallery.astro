---
import Page from "../layouts/Page.astro";
import { directions, mockPath, path } from "../data/directions";
import type { Locale } from "../data/cv";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === "es";
---

<Page
  locale={locale}
  title={es ? "Cinco mundos para un CV" : "Five worlds for one CV"}
>
  <header class="gallery-header">
    <a class="wordmark" href={path()}>Matteo Fecci</a>
    <nav aria-label={es ? "Idioma" : "Language"}>
      <a href={path("es/")} lang="es" aria-current={es ? "page" : undefined}
        >ES</a
      >
      <a href={path("en/")} lang="en" aria-current={!es ? "page" : undefined}
        >EN</a
      >
    </nav>
  </header>
  <main id="main" class="gallery-main">
    <h1>{es ? "Cinco mundos. Un CV." : "Five worlds. One CV."}</h1>
    <p class="gallery-intro">
      {
        es
          ? "El mismo perfil profesional en cinco direcciones independientes. Ninguna está elegida: abre las propuestas y decide qué mundo cuenta mejor la historia."
          : "The same professional profile in five independent directions. None is selected: open the proposals and choose the world that tells the story best."
      }
    </p>
    <div class="direction-wall">
      {
        directions.map((direction, index) => (
          <article class="direction-card" style={`--plate-order: ${index}`}>
            <a class="preview-link" href={mockPath(locale, direction.id)}>
              <img
                src={path(`previews/${direction.id}.png`)}
                width="1440"
                height="900"
                alt={`${direction.title[locale]}: ${direction.source}`}
                loading="lazy"
              />
            </a>
            <div class="direction-caption">
              <p class="specimen-source">
                {direction.specimen} / {direction.source}
              </p>
              <h2>
                <a href={mockPath(locale, direction.id)}>
                  {direction.title[locale]}
                </a>
              </h2>
              <p>{direction.description[locale]}</p>
              <a class="text-link" href={mockPath(locale, direction.id)}>
                {es ? "Abrir propuesta" : "Open proposal"}
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="selection-note">
      {
        es
          ? "Son mocks de selección, no cinco versiones de la aplicación definitiva. Después de elegir una, se desarrollará solo esa dirección."
          : "These are selection mocks, not five versions of the final application. After choosing, only that direction will be developed."
      }
    </p>
  </main>
  <footer class="gallery-footer">
    {
      es
        ? "Código MIT. CV, textos biográficos e identidad excluidos."
        : "MIT code. CV, biographical text and identity excluded."
    }
  </footer>
</Page>
